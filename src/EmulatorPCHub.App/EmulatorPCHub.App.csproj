<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(HubWinTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EmulatorPCHub.App</RootNamespace>
    <AssemblyName>Emulator PC Hub</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icons\hub.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmulatorPCHub.Core\EmulatorPCHub.Core.csproj" />
    <ProjectReference Include="..\EmulatorPCHub.Library\EmulatorPCHub.Library.csproj" />
    <ProjectReference Include="..\EmulatorPCHub.Emulation\EmulatorPCHub.Emulation.csproj" />
    <ProjectReference Include="..\EmulatorPCHub.Mods\EmulatorPCHub.Mods.csproj" />
    <ProjectReference Include="..\EmulatorPCHub.Controllers\EmulatorPCHub.Controllers.csproj" />
    <ProjectReference Include="..\EmulatorPCHub.Updates\EmulatorPCHub.Updates.csproj" />
    <ProjectReference Include="..\EmulatorPCHub.UI\EmulatorPCHub.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\icons\hub.ico" Link="Assets\hub.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\icons\hub-256.png" Link="Assets\hub-256.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
