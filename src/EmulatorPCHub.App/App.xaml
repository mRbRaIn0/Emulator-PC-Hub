<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EmulatorPCHub.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- "Basic Black" -->
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="HubBackgroundColor">#FF2D2D2D</Color>
                    <SolidColorBrush x:Key="HubBackgroundBrush" Color="#FF2D2D2D" />
                    <SolidColorBrush x:Key="HubSurfaceBrush" Color="#FF3B3B3B" />
                    <SolidColorBrush x:Key="HubSurfaceAltBrush" Color="#FF474747" />
                    <SolidColorBrush x:Key="HubTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="HubSubtleBrush" Color="#FFB4B4B4" />
                    <SolidColorBrush x:Key="HubDividerBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="HubOverlayBrush" Color="#E6202020" />
                </ResourceDictionary>
                <!-- "Basic White" -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="HubBackgroundColor">#FFEBEBEB</Color>
                    <SolidColorBrush x:Key="HubBackgroundBrush" Color="#FFEBEBEB" />
                    <SolidColorBrush x:Key="HubSurfaceBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="HubSurfaceAltBrush" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="HubTextBrush" Color="#FF2D2D2D" />
                    <SolidColorBrush x:Key="HubSubtleBrush" Color="#FF6B6B6B" />
                    <SolidColorBrush x:Key="HubDividerBrush" Color="#22000000" />
                    <SolidColorBrush x:Key="HubOverlayBrush" Color="#F0F4F4F4" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Auswahlfarbe wie der typische Konsolen-Fokusrahmen -->
            <Color x:Key="HubAccentColor">#FF00C3E3</Color>
            <SolidColorBrush x:Key="HubAccentBrush" Color="#FF00C3E3" />
            <SolidColorBrush x:Key="HubRedBrush" Color="#FFE60012" />
            <SolidColorBrush x:Key="HubGreenBrush" Color="#FF2ECC71" />
            <SolidColorBrush x:Key="HubWarnBrush" Color="#FFF39C12" />

            <x:Double x:Key="HubTileSize">256</x:Double>

            <Style x:Key="HubTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource HubTextBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="HubHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource HubTextBrush}" />
                <Setter Property="Margin" Value="0,18,0,8" />
            </Style>
            <Style x:Key="HubBodyText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{ThemeResource HubTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="HubSubtleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource HubSubtleBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="HubCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource HubSurfaceBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!-- Standard-Button im Hub-Look (runde Ecken, cyanfarbener Fokusrahmen) -->
            <Style x:Key="HubButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="22,10" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource HubAccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="3" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="FocusVisualMargin" Value="-4" />
            </Style>
            <Style x:Key="HubPrimaryButton" TargetType="Button" BasedOn="{StaticResource HubButton}">
                <Setter Property="Background" Value="{StaticResource HubRedBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Padding" Value="40,12" />
                <Setter Property="MinHeight" Value="52" />
            </Style>

            <!-- Auswahl-Karte für Editionen/Engines/Presets -->
            <Style x:Key="HubOptionButton" TargetType="Button" BasedOn="{StaticResource HubButton}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Background" Value="{ThemeResource HubSurfaceAltBrush}" />
            </Style>

            <!-- Runde Buttons der unteren Navigation -->
            <Style x:Key="HubRoundButton" TargetType="Button" BasedOn="{StaticResource HubButton}">
                <Setter Property="Width" Value="68" />
                <Setter Property="Height" Value="68" />
                <Setter Property="CornerRadius" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{ThemeResource HubSurfaceBrush}" />
                <Setter Property="FocusVisualMargin" Value="-5" />
            </Style>

            <!-- Pop-up-Dialoge (ContentDialog) im Hub-Look: größer, eine Fläche, runde Tasten -->
            <x:Double x:Key="ContentDialogMinWidth">540</x:Double>
            <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
            <x:Double x:Key="ContentDialogMaxHeight">820</x:Double>
            <Thickness x:Key="ContentDialogPadding">32,28,32,28</Thickness>
            <Thickness x:Key="ContentDialogTitleMargin">0,0,0,14</Thickness>
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />

            <Style x:Key="HubDialogButton" TargetType="Button" BasedOn="{StaticResource HubButton}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Padding" Value="24,12" />
                <Setter Property="CornerRadius" Value="26" />
            </Style>
            <Style x:Key="HubDialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource HubDialogButton}">
                <Setter Property="Background" Value="{StaticResource HubRedBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="HubToggle" TargetType="ToggleSwitch">
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource HubAccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="3" />
                <Setter Property="Foreground" Value="{ThemeResource HubTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
