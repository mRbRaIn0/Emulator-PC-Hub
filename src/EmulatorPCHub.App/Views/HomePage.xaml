<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EmulatorPCHub.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Titel des ausgewählten Spiels -->
            <TextBlock x:Name="SelectedTitle" Style="{StaticResource HubTitleText}" FontSize="26" Margin="64,0,64,6"
                       Foreground="{StaticResource HubAccentBrush}" />

            <!-- Horizontale Spiele-Kacheln -->
            <ScrollViewer x:Name="TileScroller" Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="52,26,52,26">
                <StackPanel x:Name="TilesPanel" Orientation="Horizontal" />
            </ScrollViewer>

            <!-- Infos zum ausgewählten Spiel -->
            <Grid Grid.Row="2" Margin="64,14,64,0">
                <StackPanel Orientation="Horizontal" Spacing="26">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="InfoPlatform" FontSize="15" Foreground="{ThemeResource HubSubtleBrush}" />
                        <TextBlock x:Name="InfoPreset" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource HubTextBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Spielzeit" FontSize="15" Foreground="{ThemeResource HubSubtleBrush}" />
                        <TextBlock x:Name="InfoPlaytime" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource HubTextBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="InfoLastLabel" Text="Status" FontSize="15" Foreground="{ThemeResource HubSubtleBrush}" />
                        <TextBlock x:Name="InfoLast" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource HubTextBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Startet mit" FontSize="15" Foreground="{ThemeResource HubSubtleBrush}" />
                        <TextBlock x:Name="InfoEmulator" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource HubTextBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Controller-Empfehlung" FontSize="15" Foreground="{ThemeResource HubSubtleBrush}" />
                        <StackPanel x:Name="InfoControllers" Orientation="Horizontal" Spacing="6" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="StartButton" Style="{StaticResource HubPrimaryButton}" HorizontalAlignment="Right" Click="StartButton_Click"
                        IsTabStop="False">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE768;" FontSize="18" />
                        <TextBlock x:Name="StartButtonText" Text="Starten" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock x:Name="EmptyHint" Grid.Row="2" Margin="64,90,64,0" Style="{StaticResource HubSubtleText}" />
        </Grid>

        <!-- Untere Navigation: News | Library | Profile | Mii | Spielstände | Statistik | Controller | Mods | Komponenten | Settings | Power -->
        <StackPanel x:Name="NavPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,8,0,22" />
    </Grid>
</Page>
