<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.1.0</Version>
    <Company>Emulator PC Hub</Company>
    <Product>Emulator PC Hub</Product>
    <Copyright>Unabhängiges Projekt. Enthält keine Spiele, Firmware, Keys oder fremde Assets.</Copyright>
    <!-- Keine lokalen Build-Pfade in DLLs/PDBs einbetten -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <!-- Gemeinsame Ziel-Frameworks -->
    <HubTfm>net10.0</HubTfm>
    <HubWinTfm>net10.0-windows10.0.19041.0</HubWinTfm>
  </PropertyGroup>
</Project>
